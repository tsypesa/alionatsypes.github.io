---
import type { Publication } from '../data/publications';

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
---

<article class="bg-white rounded-xl p-6 md:p-8 border border-border-warm card-hover">
  <a href={publication.url} target="_blank" rel="noopener noreferrer" class="block group">
    <h3 class="font-heading text-lg md:text-xl font-semibold text-text-primary group-hover:text-teal-700 transition-colors mb-3">
      {publication.title}
    </h3>
    <p class="text-sm text-text-secondary mb-2">{publication.authors}</p>
    <p class="text-sm text-text-secondary font-medium mb-4">{publication.citation}</p>
  </a>
  {publication.summary && (
    <details class="text-text-secondary text-sm leading-relaxed">
      <summary class="cursor-pointer text-teal-700 font-medium hover:underline">
        Read Summary<span class="sr-only"> of {publication.title}</span>
      </summary>
      <p class="mt-3 pl-4 border-l-2 border-primary/30">{publication.summary}</p>
    </details>
  )}
</article>
