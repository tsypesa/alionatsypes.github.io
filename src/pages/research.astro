---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchQuestions from "../components/ResearchQuestions.astro";
import { selectedResearchQuestions } from "../data/publications";
---

<BaseLayout title="Research | Aliona Tsypes, PhD" activeItemID="research">
  <div class="mb-12">
    <h1 class="font-heading text-4xl md:text-5xl font-bold text-text-primary mb-3">
      Research
    </h1>
    <div class="w-16 h-1 bg-primary/30 rounded-full mb-6"></div>
    <p class="text-text-secondary text-lg leading-relaxed">
      My research seeks to better understand suicidal thoughts and behavior by examining the processes associated with suicidal behavior, the circumstances in which suicidal ideation fluctuates, and individual differences in these experiences. I combine experimental, computational, neural, clinical, and intensive longitudinal approaches to investigate these complementary questions.
    </p>
  </div>

  <section aria-labelledby="research-questions-heading" class="mb-16">
    <h2 id="research-questions-heading" class="font-heading text-2xl md:text-3xl font-bold text-text-primary mb-8">
      Selected Research Questions
    </h2>
    <ResearchQuestions questions={selectedResearchQuestions} />
  </section>

  <section aria-labelledby="support-heading" class="border-t border-border-warm pt-12">
    <h2 id="support-heading" class="font-heading text-2xl md:text-3xl font-bold text-text-primary mb-8">
      Research Support
    </h2>
    <article class="bg-white rounded-xl p-6 md:p-8 border border-border-warm">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 bg-primary/10 text-teal-700 text-sm font-medium rounded-full">NIMH K23 MH130664</span>
        <span class="text-sm text-text-secondary">2023–2028 · Principal Investigator</span>
      </div>
      <h3 class="font-heading text-xl font-semibold text-text-primary mb-4">
        Cortical Oscillatory Dynamics and Decision Deficits in Suicidal Behavior
      </h3>
      <p class="text-text-secondary leading-relaxed mb-4">
        This project uses EEG and behavioral experiments to investigate how cognitive demands affect decision-making in people with different histories of suicidal thoughts and behavior. It tests how limits on cognitive resources relate to decision processes relevant to suicidal behavior.
      </p>
      <a href="https://reporter.nih.gov/search/4ctwTujJIkGsdbce0hHGVA/project-details/10841630" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-teal-700 underline underline-offset-4 hover:decoration-primary font-medium text-sm">
        View on NIH RePORTER
      </a>
    </article>

    <details class="mt-8">
      <summary class="cursor-pointer font-heading text-xl font-semibold text-text-primary hover:text-teal-700">
        Previous research support and awards
      </summary>
      <div class="mt-6">
    <div class="space-y-6">
      <!-- F31 Grant -->
      <article class="bg-white rounded-xl p-6 md:p-8 border border-border-warm">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 bg-accent/10 text-accent text-sm font-medium rounded-full">
            F31 MH114319
          </span>
          <span class="text-sm text-text-muted">2017-2019</span>
        </div>

        <h3 class="font-heading text-xl font-semibold text-text-primary mb-4">
          A Fine-grained EEG/ERP Examination of Reward Processing in Suicide Attempters
        </h3>

        <div class="grid sm:grid-cols-2 gap-4 mb-4 text-sm">
          <div>
            <span class="text-text-muted">Role:</span>
            <span class="text-text-primary font-medium ml-2">PI</span>
          </div>
          <div>
            <span class="text-text-muted">Source:</span>
            <span class="text-text-primary font-medium ml-2">NIMH, $62,303</span>
          </div>
        </div>

        <p class="text-text-secondary leading-relaxed mb-4">
          This award supported EEG/ERP research on reward anticipation and initial reward responses in adults with and without a history of suicide attempts.
        </p>

        <a
          href="https://reporter.nih.gov/search/5BrfhIgryEaaSJezq5swxQ/project-details/9606380"
          target="_blank"
          class="inline-flex items-center gap-2 text-primary hover:underline font-medium text-sm"
        >
          View on NIH RePORTER
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </article>

      <!-- T32 Grant -->
      <article class="bg-white rounded-xl p-6 md:p-8 border border-border-warm">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 bg-secondary/10 text-secondary text-sm font-medium rounded-full">
            T32 MH018269
          </span>
          <span class="text-sm text-text-muted">2020-2023</span>
        </div>

        <h3 class="font-heading text-xl font-semibold text-text-primary mb-3">
          Clinical Research Training for Psychologists
        </h3>

        <div class="grid sm:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-text-muted">Role:</span>
            <span class="text-text-primary font-medium ml-2">Postdoctoral Trainee</span>
          </div>
          <div>
            <span class="text-text-muted">Source:</span>
            <span class="text-text-primary font-medium ml-2">NIMH</span>
          </div>
        </div>
      </article>

      <!-- NSF GRFP -->
      <article class="bg-white rounded-xl p-6 md:p-8 border border-border-warm">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 bg-surface text-text-secondary text-sm font-medium rounded-full border border-border-warm">
            NSF GRFP
          </span>
          <span class="text-sm text-text-muted">2014-2017</span>
        </div>

        <h3 class="font-heading text-xl font-semibold text-text-primary mb-3">
          Cognition, Attention, Reward, and Emotion in Suicide Attempters
        </h3>

        <div class="grid sm:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-text-muted">Role:</span>
            <span class="text-text-primary font-medium ml-2">PI</span>
          </div>
          <div>
            <span class="text-text-muted">Source:</span>
            <span class="text-text-primary font-medium ml-2">NSF Graduate Research Fellowship, $138,000</span>
          </div>
        </div>
      </article>

      <!-- NSF GROW -->
      <article class="bg-white rounded-xl p-6 md:p-8 border border-border-warm">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="px-3 py-1 bg-surface text-text-secondary text-sm font-medium rounded-full border border-border-warm">
            NSF GROW
          </span>
          <span class="text-sm text-text-muted">2017</span>
        </div>

        <h3 class="font-heading text-xl font-semibold text-text-primary mb-3">
          Using EEG/ERP to Gain a Fine-grained Understanding of Reward Processing
        </h3>

        <div class="grid sm:grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-text-muted">Role:</span>
            <span class="text-text-primary font-medium ml-2">PI</span>
          </div>
          <div>
            <span class="text-text-muted">Source:</span>
            <span class="text-text-primary font-medium ml-2">NSF GROW (Sydney, Australia), $10,700</span>
          </div>
        </div>
      </article>

      <!-- Other Awards -->
      <div class="grid md:grid-cols-2 gap-6">
        <article class="bg-white rounded-xl p-6 border border-border-warm">
          <span class="text-sm text-text-muted block mb-2">2017</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary mb-2">
            Presidential Distinguished Student Research Award
          </h3>
          <p class="text-text-secondary text-sm">Binghamton University, $10,000</p>
        </article>

        <article class="bg-white rounded-xl p-6 border border-border-warm">
          <span class="text-sm text-text-muted block mb-2">2017</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary mb-2">
            Dissertation Research Award
          </h3>
          <p class="text-text-secondary text-sm">APA, $1,000</p>
        </article>

        <article class="bg-white rounded-xl p-6 border border-border-warm">
          <span class="text-sm text-text-muted block mb-2">2017</span>
          <h3 class="font-heading text-lg font-semibold text-text-primary mb-2">
            Charles and Carol Spielberger Scholarship
          </h3>
          <p class="text-text-secondary text-sm">American Psychological Foundation, $5,000</p>
        </article>
      </div>
    </div>
      </div>
    </details>
  </section>
</BaseLayout>
