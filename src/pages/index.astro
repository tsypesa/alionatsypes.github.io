---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import { featuredPublications } from "../data/publications";
---

<BaseLayout title="Aliona Tsypes, PhD | Psychiatry and Suicide Research" activeItemID="home">
  <!-- Hero Section -->
  <section class="py-8 md:py-12">
    <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
      <!-- Profile Photo -->
      <div class="flex-shrink-0">
        <img
          src="/profile.webp"
          alt="Dr. Aliona Tsypes"
          class="w-40 h-40 md:w-52 md:h-52 rounded-full object-cover ring-4 ring-primary/10 shadow-lg"
        />
      </div>

      <!-- Bio Content -->
      <div class="text-center md:text-left">
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-text-primary mb-3">
          Aliona Tsypes, PhD
        </h1>
        <p class="text-xl text-primary font-medium mb-4">
          Assistant Professor of Psychiatry
        </p>
        <p class="text-text-secondary text-lg leading-relaxed mb-5">
          I am an Assistant Professor of Psychiatry at the University of Pittsburgh and a licensed clinical psychologist. My research examines cognitive, behavioral, and neural processes associated with suicidal thoughts and behavior, with a particular focus on reward processing, learning, and decision-making.
        </p>
        <p class="text-text-secondary text-lg leading-relaxed mb-8">
          I study how people evaluate alternatives, respond to rewards and losses, and adjust their choices using behavioral experiments, computational modeling, and EEG. Complementary clinical and intensive longitudinal research examines how suicidal ideation relates to interpersonal experiences, reasons for living, and individual characteristics. I also investigate distinct correlates of suicidal ideation, suicide attempts, and nonsuicidal self-injury, including among autistic adults.
        </p>

        <p class="mb-6">
          <a href="/research" class="text-teal-700 font-medium underline decoration-primary/30 underline-offset-4 hover:decoration-teal-700">Explore my research</a>
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
          <a
            href="https://www.psychiatry.pitt.edu/about-us/our-people/faculty/aliona-tsypes-phd"
            target="_blank"
            class="btn-primary-custom"
          >
            Faculty Page
          </a>
          <a
            href="https://scholar.google.com/citations?user=h30aBXUAAAAJ&hl=en"
            target="_blank"
            class="btn-outline-custom"
          >
            Google Scholar
          </a>
          <a
            href="/cv.pdf"
            target="_blank"
            class="btn-outline-custom"
          >
            CV
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="border-t border-border-warm my-12"></div>

  <!-- Publications Section -->
  <section aria-labelledby="publications-heading">
    <div class="mb-10">
      <h2 id="publications-heading" class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-3">
        Representative Publications
      </h2>
      <div class="w-16 h-1 bg-primary/30 rounded-full"></div>
    </div>

    <div class="space-y-6">
      {featuredPublications.map(publication => <PublicationCard publication={publication} />)}
    </div>

    <p class="text-text-secondary mt-8 leading-relaxed">
      Explore the <a href="/research" class="text-teal-700 underline underline-offset-4 hover:decoration-primary">research questions behind these studies</a>, including additional publications and research support.
    </p>
  </section>
</BaseLayout>
